{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/index-hook.sh\" PostToolUse refresh-index.py",
            "timeout": 15,
            "statusMessage": "refreshing the code index"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/index-hook.sh\" SessionStart refresh-index.py",
            "timeout": 15,
            "statusMessage": "refreshing the code index"
          }
        ]
      }
    ]
  }
}
