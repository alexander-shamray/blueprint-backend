{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py -3.12 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/refresh-index.py\"",
            "timeout": 5,
            "statusMessage": "refreshing the code index"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3.12 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/refresh-index.py\"",
            "timeout": 5,
            "statusMessage": "refreshing the code index"
          }
        ]
      }
    ]
  }
}
