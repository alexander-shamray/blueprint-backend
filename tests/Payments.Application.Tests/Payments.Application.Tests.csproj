<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are self-executing: the runner is compiled in
         rather than loaded by a host, so the assembly has to be an Exe. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <!-- The §4.2 gates that reason over type dependencies rather than
         assembly references — a job GetReferencedAssemblies cannot do. -->
    <PackageReference Include="NetArchTest.Rules" />
    <!-- ServiceCollection itself, for the registration tests: the
         abstractions package Payments.Application compiles against has no
         container in it to build. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- ConfigurationBuilder and AddInMemoryCollection: AddPaymentsInfrastructure
         takes an IConfiguration, and OutboxSerialisationTests builds a real
         one rather than substitute the contract. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <!-- AuthorisePaymentHandlerTests names NullLogger<T> directly — a
         project that names a package's type references the package
         directly, rather than leaning on what Common.Application carries. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Services\Payments\Payments.Application\Payments.Application.csproj" />
    <!-- No Payments.TestSupport and no Docker: the handlers here run against
         hand-rolled fakes, because what is worth pinning is what each one
         sent or decided, not a database. The persisted write is exercised
         over a real broker and database in the API suite, which already
         carries the fixture a second copy here would duplicate.
         Payments.Infrastructure is referenced for AddPaymentsInfrastructure,
         so the Local lane's payload contract (§9.4) is checked against the
         real registration; §4.2's gate binds Payments.Application, not its
         tests. -->
    <ProjectReference Include="..\..\src\Services\Payments\Payments.Infrastructure\Payments.Infrastructure.csproj" />
  </ItemGroup>

</Project>
