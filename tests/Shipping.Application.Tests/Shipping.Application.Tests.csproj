<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are self-executing: the runner is compiled in
         rather than loaded by a host, so the assembly has to be an Exe. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <!-- The §4.2 gates that reason over type dependencies rather than
         assembly references — a job GetReferencedAssemblies cannot do. -->
    <PackageReference Include="NetArchTest.Rules" />
    <!-- ServiceCollection itself, for the registration tests: the
         abstractions package Shipping.Application compiles against has no
         container in it to build. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Services\Shipping\Shipping.Application\Shipping.Application.csproj" />
    <!-- No Shipping.TestSupport and no Docker, which departs from §12.1's
         Application row on purpose: the handlers here run against hand-rolled
         fakes, because what is worth pinning is the row each one writes or
         leaves, not a database. The persisted write runs over a real broker
         and database in the worker's suite, which already carries the fixture
         a second copy here would duplicate. -->
  </ItemGroup>

</Project>
