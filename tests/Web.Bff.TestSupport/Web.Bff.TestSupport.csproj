<Project Sdk="Microsoft.NET.Sdk">

  <!-- Not a test project (§4.1). The stub's server half of pricing.proto, compiled beside Web.Bff's client half,
       would define every message twice in one compilation, and CS0436 is an error under ADR-019. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- MapGrpcService and the Kestrel host behind it. Grpc.Tools rides in
         with this one and compiles the Protobuf item below. -->
    <PackageReference Include="Grpc.AspNetCore" />
    <!-- IAsyncLifetime. xunit.v3 itself refuses non-Exe output and names this
         package as the alternative — the same line Catalog.TestSupport takes. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <!-- The server half of the contract Web.Bff compiles as a client, from the .proto alone (§4.3). -->
    <Protobuf
      Include="..\..\src\Services\Catalog\Catalog.Api\Protos\pricing.proto"
      Link="Protos\pricing.proto"
      GrpcServices="Server" />
  </ItemGroup>

</Project>
