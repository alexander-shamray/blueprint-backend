<Project Sdk="Microsoft.NET.Sdk">

  <!-- Not a test project (§4.1): Library output, referenced by each sibling suite that needs containers. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- TestContext; not xunit.v3, which refuses Library output. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
    <!-- WebApplicationFactory over the real Program (§12.4). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Named although transitive, because ServiceFixture uses its types directly. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- Named although transitive, because OrderingApiFactory names ADR-032's InboxCleanupService<T>. -->
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- The body every service's ServiceFixture shares (ADR-056). -->
    <ProjectReference Include="..\Common.TestSupport\Common.TestSupport.csproj" />
    <ProjectReference Include="..\..\src\Services\Ordering\Ordering.Api\Ordering.Api.csproj" />
    <!-- The migrator, so the fixture drives the real §7.4 job host. -->
    <ProjectReference Include="..\..\src\Services\Ordering\Ordering.Migrator\Ordering.Migrator.csproj" />
  </ItemGroup>

</Project>
