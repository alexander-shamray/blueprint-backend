<Project Sdk="Microsoft.NET.Sdk">

  <!-- Not a test project (§4.1): Library output, referenced by each sibling suite that needs containers. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- TestContext; not xunit.v3, which refuses Library output. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
    <!-- WebApplicationFactory over the real Program (§12.4). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Named although transitive, because ServiceFixture uses its types directly. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- The carrier's stand-in, started over the simulator's mappings. -->
    <PackageReference Include="WireMock.Net" />
  </ItemGroup>

  <ItemGroup>
    <!-- The body every service's ServiceFixture shares (ADR-056). -->
    <ProjectReference Include="..\Common.TestSupport\Common.TestSupport.csproj" />
    <ProjectReference Include="..\..\src\Services\Shipping\Shipping.Worker\Shipping.Worker.csproj" />
    <!-- The migrator, so the fixture drives the real §7.4 job host. -->
    <ProjectReference Include="..\..\src\Services\Shipping\Shipping.Migrator\Shipping.Migrator.csproj" />
    <!-- StubOrdering, the stand-in for Ordering's address read (ADR-052). -->
    <ProjectReference Include="..\Shipping.OrderingStub\Shipping.OrderingStub.csproj" />
  </ItemGroup>

</Project>
