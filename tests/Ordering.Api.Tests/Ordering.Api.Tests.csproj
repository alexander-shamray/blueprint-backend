<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are self-executing: the runner is compiled in
         rather than loaded by a host, so the assembly has to be an Exe. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <!-- The composition-root gate (§4.2), which reads type-level dependencies, not GetReferencedAssemblies. -->
    <PackageReference Include="NetArchTest.Rules" />
    <!-- WebApplicationFactory over the real Program (§12.4), named directly by these tests. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- SqlServerRetryingExecutionStrategy, for the retry test's fault-injecting subclass. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- The in-memory harness; core, not MassTransit.RabbitMQ, since the harness swaps the transport out. -->
    <PackageReference Include="MassTransit" />
    <!-- Named although transitive, for ADR-032's EntityFrameworkOutboxOptions<OrderingDbContext>. -->
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <!-- Captures the IPipe<PublishContext> the dispatcher hands IPublishEndpoint, for §9.1's single identity. -->
    <PackageReference Include="NSubstitute" />
    <!-- Named although transitive, for GrpcChannel and StatusCode against the gRPC server. -->
    <PackageReference Include="Grpc.Net.ClientFactory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Services\Ordering\Ordering.Api\Ordering.Api.csproj" />
    <!-- The fixtures, in their own project since test projects cannot reference each other (§4.1). -->
    <ProjectReference Include="..\..\tests\Ordering.TestSupport\Ordering.TestSupport.csproj" />
  </ItemGroup>

</Project>
