<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are self-executing: the runner is compiled in
         rather than loaded by a host, so the assembly has to be an Exe. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <!-- FluentValidation.TestHelper is named directly, so its package is referenced directly. -->
    <PackageReference Include="FluentValidation" />
    <!-- The §4.2 gates that reason over type dependencies rather than
         assembly references — a job GetReferencedAssemblies cannot do. -->
    <PackageReference Include="NetArchTest.Rules" />
    <!-- ServiceCollection itself; the abstractions package has no container to build. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- ConfigurationBuilder, for the IConfiguration AddInventoryInfrastructure takes. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Services\Inventory\Inventory.Application\Inventory.Application.csproj" />
    <!-- CommandFingerprintRule's selection of an idempotent command, the one every gate over them reads. -->
    <ProjectReference Include="..\Common.TestSupport\Common.TestSupport.csproj" />
    <!-- No Inventory.TestSupport and no Docker: the Dapper queries run against a real database in Inventory.Api.Tests.
         Inventory.Infrastructure is referenced so §9.4's payload contract meets the real registration. -->
    <ProjectReference Include="..\..\src\Services\Inventory\Inventory.Infrastructure\Inventory.Infrastructure.csproj" />
  </ItemGroup>

</Project>
