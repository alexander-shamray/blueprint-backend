<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are self-executing: the runner is compiled in
         rather than loaded by a host, so the assembly has to be an Exe. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <!-- SetOnHandValidatorTests names FluentValidation.TestHelper directly;
         the register's honesty rule is that an assembly named directly is
         referenced directly, so it does not ride in on Inventory.Application
         alone. -->
    <PackageReference Include="FluentValidation" />
    <!-- The §4.2 gates that reason over type dependencies rather than
         assembly references — a job GetReferencedAssemblies cannot do. -->
    <PackageReference Include="NetArchTest.Rules" />
    <!-- ServiceCollection itself, for the registration tests: the
         abstractions package Inventory.Application compiles against has no
         container in it to build. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- ConfigurationBuilder and AddInMemoryCollection: AddInventoryInfrastructure
         takes an IConfiguration, and OutboxSerialisationTests builds a real
         one rather than substitute the contract. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Services\Inventory\Inventory.Application\Inventory.Application.csproj" />
    <!-- Inventory.Infrastructure for AddInventoryInfrastructure, which
         OutboxSerialisationTests resolves OutboxJson and MessageTypeMap out
         of. §4.2's gate binds Inventory.Application, not its tests.

         Still no Inventory.TestSupport and no Docker: GetStockHandler's
         Dapper query is exercised against a real database by
         StockEndpointsTests in Inventory.Api.Tests, which already carries
         the fixture, the DbContext reference and the provider package a
         second copy here would duplicate. -->
    <ProjectReference Include="..\..\src\Services\Inventory\Inventory.Infrastructure\Inventory.Infrastructure.csproj" />
  </ItemGroup>

</Project>
