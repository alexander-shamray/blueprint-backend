<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are self-executing: the runner is compiled in
         rather than loaded by a host, so the assembly has to be an Exe. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <!-- The contracts are one assembly referencing nothing (§4.3), so the assertions are about all of it. -->
    <ProjectReference Include="..\..\src\BuildingBlocks\Common.Contracts\Common.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- §3.2's two timings, read side by side here, since neither service reads the other's assembly (§4.2). -->
    <ProjectReference Include="..\..\src\Services\Ordering\Ordering.Infrastructure\Ordering.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Services\Payments\Payments.Infrastructure\Payments.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read from the output directory, as a path-mapped CI build has no source path to read it from. -->
    <None Update="contract-shapes.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
