<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are self-executing: the runner is compiled in
         rather than loaded by a host, so the assembly has to be an Exe. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <!-- WebApplicationFactory over each real Program (§12.4), named directly by the journey. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- The one SQL Server, broker and Redis pair every journey host shares (§12.1), named directly by its world. -->
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="Testcontainers.Redis" />
    <!-- The journey reads each service's rows with plain ADO, which no service's model should be loaded for. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- The provider's, the carrier's and the contact source's simulators, on loopback (§14.1). -->
    <PackageReference Include="WireMock.Net" />
    <!-- Ordering's bus, for the expiries the saga would otherwise wait minutes for. -->
    <PackageReference Include="MassTransit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The contracts are one assembly referencing nothing (§4.3), so the assertions are about all of it. -->
    <ProjectReference Include="..\..\src\BuildingBlocks\Common.Contracts\Common.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- §3.2's two timings, read side by side here, since neither service reads the other's assembly (§4.2). -->
    <ProjectReference Include="..\..\src\Services\Ordering\Ordering.Infrastructure\Ordering.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Services\Payments\Payments.Infrastructure\Payments.Infrastructure.csproj" />
    <!-- And Shipping, which sizes three values against the saga's despatch wait and cannot read it (§4.2). -->
    <ProjectReference Include="..\..\src\Services\Shipping\Shipping.Infrastructure\Shipping.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The BFF holds a buyer's orders, so the erasure journey (§11.7) runs it too. Aliased because its host is a
         public Program, which every test-support project's own would make ambiguous in this one. -->
    <ProjectReference Include="..\..\src\BFF\Web.Bff\Web.Bff.csproj" Aliases="WebBff" />
    <ProjectReference Include="..\..\src\BFF\Web.Bff.Migrator\Web.Bff.Migrator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The journey (§12.1): every host that §3.2 puts on the fulfilment path, over the harness its own suite uses. -->
    <ProjectReference Include="..\Catalog.TestSupport\Catalog.TestSupport.csproj" />
    <ProjectReference Include="..\Ordering.TestSupport\Ordering.TestSupport.csproj" />
    <ProjectReference Include="..\Inventory.TestSupport\Inventory.TestSupport.csproj" />
    <ProjectReference Include="..\Payments.TestSupport\Payments.TestSupport.csproj" />
    <ProjectReference Include="..\Shipping.TestSupport\Shipping.TestSupport.csproj" />
    <ProjectReference Include="..\Notifications.TestSupport\Notifications.TestSupport.csproj" />
    <ProjectReference Include="..\Privacy.TestSupport\Privacy.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Read from the output directory, as a path-mapped CI build has no source path to read it from. -->
    <None Update="contract-shapes.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shipping's chart and Compose values for the give-up age, read as they ship rather than restated. -->
    <None Include="..\..\deploy\helm\shipping\values.yaml" Link="shipping-values.yaml"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\deploy\compose\services\shipping.yml" Link="shipping-compose.yml"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
