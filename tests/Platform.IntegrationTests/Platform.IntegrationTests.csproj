<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are self-executing: the runner is compiled in
         rather than loaded by a host, so the assembly has to be an Exe. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The platform's contracts are a single assembly that itself references
      nothing (§4.3), so the contract assertions are about the whole assembly
      rather than about any service in it.
    -->
    <ProjectReference Include="..\..\src\BuildingBlocks\Common.Contracts\Common.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      §3.2 holds Payments' redelivery ladder to Ordering's payment timeout
      without either service reading the other's assembly (§4.2); this suite
      is where the two constants are read side by side instead.
    -->
    <ProjectReference Include="..\..\src\Services\Ordering\Ordering.Infrastructure\Ordering.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Services\Payments\Payments.Infrastructure\Payments.Infrastructure.csproj" />
  </ItemGroup>

</Project>
