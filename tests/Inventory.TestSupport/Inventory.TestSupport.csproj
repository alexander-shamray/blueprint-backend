<Project Sdk="Microsoft.NET.Sdk">

  <!-- Not a test project (§4.1): Library output, referenced by each sibling suite that needs containers. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- IAsyncLifetime and TestContext; not xunit.v3, which refuses Library output. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
    <!-- WebApplicationFactory over the real Program (§12.4). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Real SQL Server, per ADR-010. -->
    <PackageReference Include="Testcontainers.MsSql" />
    <!-- Real RabbitMQ, on the same terms. -->
    <PackageReference Include="Testcontainers.RabbitMq" />
    <PackageReference Include="Testcontainers.Redis" />
    <!-- Reset-by-truncation between tests (§12.4). -->
    <PackageReference Include="Respawn" />
    <!-- The open connection Respawn inspects. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- Named although transitive, because ServiceFixture uses its types directly. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Services\Inventory\Inventory.Api\Inventory.Api.csproj" />
    <!-- The migrator, so the fixture drives the real §7.4 job host. -->
    <ProjectReference Include="..\..\src\Services\Inventory\Inventory.Migrator\Inventory.Migrator.csproj" />
  </ItemGroup>

</Project>
