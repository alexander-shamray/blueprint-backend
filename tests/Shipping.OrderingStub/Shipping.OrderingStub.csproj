<Project Sdk="Microsoft.NET.Sdk">

  <!-- Not a test project (§4.1) and not a second TestSupport: a stub server referencing nothing of Shipping's,
       outside Shipping.Infrastructure because §3.2 gives Shipping no API for a gRPC service base to serve. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- MapGrpcService and the Kestrel host behind it. Grpc.Tools rides in
         with this one and compiles the Protobuf item below. -->
    <PackageReference Include="Grpc.AspNetCore" />
    <!-- IAsyncLifetime; not xunit.v3, which refuses Library output. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

  <ItemGroup>
    <!-- The server half of the contract Shipping.Infrastructure compiles as a client. Ordering owns the file
         (ADR-052), and consuming the .proto rather than an assembly keeps §4.3 true. -->
    <Protobuf
      Include="..\..\src\Services\Ordering\Ordering.Api\Protos\delivery_addresses.proto"
      Link="Protos\delivery_addresses.proto"
      GrpcServices="Server" />
  </ItemGroup>

</Project>
