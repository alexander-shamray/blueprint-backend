<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are self-executing: the runner is compiled in
         rather than loaded by a host, so the assembly has to be an Exe. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Grpc.Core's StatusCode, named directly by these tests though carried transitively. -->
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <!-- HttpStandardResilienceOptions, read off the built host (§9.7); named for the same reason. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- §11.5's suite, which proves the BFF's and shipping-worker's grants against a real Keycloak. -->
    <PackageReference Include="Testcontainers.Keycloak" />
    <!-- JwtSecurityTokenHandler, named directly though Common.Web's JwtBearer carries it. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <!-- UseSqlServer, named by the model and schema tests though Web.Bff.Persistence carries it. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- SqlException, named by the schema tests to read a refusal's number. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- The in-memory harness; core, not MassTransit.RabbitMQ, since the harness swaps the transport out. -->
    <PackageReference Include="MassTransit" />
    <!-- The publishers' outbox harness stages rows through this, named directly though Web.Bff carries it. -->
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BFF\Web.Bff\Web.Bff.csproj" />
    <!-- ADR-051's schema, which the model and schema tests read and the fixture migrates. -->
    <ProjectReference Include="..\..\src\BFF\Web.Bff.Persistence\Web.Bff.Persistence.csproj" />
    <!-- StubCatalog and pricing.proto's server half. This suite names no generated type, as both halves'
         copies would then be ambiguous; drive the stub through its own surface. -->
    <ProjectReference Include="..\Web.Bff.TestSupport\Web.Bff.TestSupport.csproj" />
    <!-- §7.4's job host, which the fixture runs for real against its container. -->
    <ProjectReference Include="..\..\src\BFF\Web.Bff.Migrator\Web.Bff.Migrator.csproj" />
    <!-- WriteEndpointRule (ADR-058) and the shared ServiceFixture body (ADR-056). -->
    <ProjectReference Include="..\Common.TestSupport\Common.TestSupport.csproj" />
    <!-- ADR-051's rebuild, proved against the consumers it feeds, which is why its suite is this one. -->
    <ProjectReference Include="..\..\tools\bff-replay\BffReplay.csproj" />
  </ItemGroup>

</Project>
