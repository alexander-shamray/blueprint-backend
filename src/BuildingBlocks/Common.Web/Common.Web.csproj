<Project Sdk="Microsoft.NET.Sdk">

  <!-- Settings from Directory.Build.props (§4.1); a library every host references, so not the Web SDK. -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- §13.2's AddObservability. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" />
    <!-- ValidationException, caught by ValidationExceptionHandler for §10.5's 400 row. -->
    <PackageReference Include="FluentValidation" />
    <!-- §11.3's AddJwtBearer, which the shared framework does not carry. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- DbUpdateConcurrencyException, which §10.5's 409 row names; the base package, never a provider. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- AddCommonOpenApi's transformer, which writes each endpoint's declared example into its document. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>

  <ItemGroup>
    <!-- Result, Error and ErrorType, which ToHttpResult maps to a status (§10.5). -->
    <ProjectReference Include="..\Common.Application\Common.Application.csproj" />
  </ItemGroup>

</Project>
