<Project Sdk="Microsoft.NET.Sdk">

  <!-- Settings from Directory.Build.props (§4.1). -->

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- §11.5's grant is fetched by client name, so a singleton never holds a handler past rotation. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- An instrumentation lands with the package it instruments (§13.2). -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" />
    <!-- The outbox (§9.4); core, not the transport, which stays in each service's Infrastructure. -->
    <PackageReference Include="MassTransit" />
    <!-- The outbox claim (§9.4) and the retention purge (§9.5): raw SQL outside any command's transaction. -->
    <PackageReference Include="Dapper" />
    <!-- The inbox shares the handler's transaction through the service's DbContext; no provider here (§9.5). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common.Application\Common.Application.csproj" />
    <ProjectReference Include="..\Common.Contracts\Common.Contracts.csproj" />
    <!-- Named although transitive: MessageTypeMap and ProjectionInvoker use IDomainEvent directly. -->
    <ProjectReference Include="..\Common.Domain\Common.Domain.csproj" />
  </ItemGroup>

</Project>
