<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Settings come from Directory.Build.props (§4.4).

    PR-14's outbox drew the edges this comment used to say it would, and
    §8.5's PR widened one of them. The Outbox folder names all three —
    IDbConnectionFactory and OutboxLane from Common.Application, IDomainEvent
    from Common.Domain, IIntegrationEvent from Common.Contracts, the last two
    because MessageTypeMap selects on exactly that pair.

    The Redis folder names an application type as well now, and this comment
    said it named none: RedisIdempotencyStore implements IIdempotencyStore,
    which is Common.Application's port (§8.5). It still names no DOMAIN type.

    MassTransit arrives with them, and it is the first common code to name one
    of its types: IPublishEndpoint, on the Broker half of DeliverAsync. Until
    PR-13 the argument for keeping it per-service was that no shared code
    needed it; this is the PR that made that stop being true.
  -->

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- IHttpClientFactory, which the token client fetches §11.5's grant over
         by name rather than over a captured HttpClient: a singleton that held
         one would keep its handler past the factory's rotation.

         No type here resolves it yet, which Ordering.Application.csproj's
         Dapper block calls a claim a project would not be making. That rule
         holds and is answered rather than waived: the claim is made true by
         the change that moves the token client in, and the locality gate is
         what splits the two — a pin is Class E's whole touch set and the move
         is Class B. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- §13.2's rule: an instrumentation lands with the package it
         instruments. The Redis one lands here, not in Common.Web — the
         connections are keyed services, invisible to the parameterless
         overload, and a host with no Redis must not carry the client. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" />
    <!-- The outbox (§9.4). MassTransit core, not the transport: the
         dispatcher publishes through IPublishEndpoint and configures no
         broker — the transport package stays in each service's
         Infrastructure, where UsingRabbitMq lives. -->
    <PackageReference Include="MassTransit" />
    <!-- The claim, complete and fail statements, and PR-15's retention purge.
         Raw SQL on a connection the port hands out, never EF: both run
         outside any command's transaction by design. -->
    <PackageReference Include="Dapper" />
    <!-- The inbox (§9.5), and the opposite decision to the line above it.
         InboxFilter writes through the *service's* DbContext because sharing
         the handler's transaction is the entire point of it, so this assembly
         names the base type — never a provider, which stays in each service's
         Infrastructure with its connection string. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- LoggerMessage.Define in OutboxDispatcher, and ILogger<T> behind it. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Common.Application\Common.Application.csproj" />
    <ProjectReference Include="..\Common.Contracts\Common.Contracts.csproj" />
    <!-- Common.Domain arrives transitively through Common.Application since
         PR-14. Named anyway: MessageTypeMap and ProjectionInvoker use
         IDomainEvent directly, and a compile against another project's
         reference is a claim this one never states. -->
    <ProjectReference Include="..\Common.Domain\Common.Domain.csproj" />
  </ItemGroup>

</Project>
