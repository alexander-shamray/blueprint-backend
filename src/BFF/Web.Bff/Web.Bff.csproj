<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The host, with ADR-051's schema beside it in Web.Bff.Persistence: §10.1 gives the BFF no domain layer. -->

  <ItemGroup>
    <!-- The client half of §9.7's hop; a client-only project has to name Grpc.Tools itself. -->
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <!-- Build-time only: protoc and the C# plugin. Nothing of it ships. -->
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- AddStandardResilienceHandler (§9.7). -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- QuoteRequestValidator (ADR-045); referenced directly because this project names its types. -->
    <PackageReference Include="FluentValidation" />
    <!-- UseSqlServer, for ADR-051's projection; Web.Bff.Persistence carries it, and this project names it. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- SqlConnectionFactory (§6.5). -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- The SQL readiness check (§13.5). -->
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <!-- UsingRabbitMq for ADR-051's consumers; Common.Infrastructure carries MassTransit's core alone. -->
    <PackageReference Include="MassTransit.RabbitMQ" />
    <!-- The projection's statements, §6.6's form; named directly though Common.Infrastructure carries it. -->
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <!-- ProjectionStats and SqlConnectionFactory are internal; the gauge's suite builds both. -->
    <InternalsVisibleTo Include="Web.Bff.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- AddCommonWebDefaults (§13.2), whose ValidationExceptionHandler makes a validation throw §10.5's 400. -->
    <ProjectReference Include="..\..\BuildingBlocks\Common.Web\Common.Web.csproj" />
    <!-- OrderLimits (§4.3, ADR-045) and the events ADR-051's projection consumes; nothing else crosses §4.2. -->
    <ProjectReference Include="..\..\BuildingBlocks\Common.Contracts\Common.Contracts.csproj" />
    <!-- §11.5's client-credentials grant, a building block by ADR-052; the BFF has no Infrastructure (§10.1). -->
    <ProjectReference Include="..\..\BuildingBlocks\Common.Infrastructure\Common.Infrastructure.csproj" />
    <!-- ADR-051's schema, which the migrator applies and this host reads and writes. -->
    <ProjectReference Include="..\Web.Bff.Persistence\Web.Bff.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked, not copied, so client and server generate from one contract; the Dockerfile copies the same path. -->
    <Protobuf
      Include="..\..\Services\Catalog\Catalog.Api\Protos\pricing.proto"
      Link="Protos\pricing.proto"
      GrpcServices="Client" />
  </ItemGroup>

</Project>
