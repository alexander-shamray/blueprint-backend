{
  // The route file §10.2 quotes, which ships every route ahead of its service
  // for the reason §10.2 gives. Comments are legal here: ASP.NET Core's JSON
  // configuration provider parses with JsonCommentHandling.Skip, and this file
  // is read by people deciding whether a path is public.
  "ReverseProxy": {
    "Routes": {
      // The only public route in the platform, and the only one whose
      // AuthorizationPolicy is "anonymous". GET alone: Catalog's POST is behind
      // catalog:write (§11.4) and is deliberately not reachable through this
      // route.
      "catalog-public": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/catalog/{**catch-all}", "Methods": [ "GET" ] },
        // "anonymous" is YARP's reserved value for AllowAnonymous. Common.Web
        // sets a fallback authorization policy (§11.4), so a route without
        // an AuthorizationPolicy key inherits it and this public GET answers
        // 401. Naming it makes the one public path a decision, not an omission.
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "anonymous",
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api" }
        ]
      },
      // The two "authenticated" values below are NOT the same policy.
      // AuthorizationPolicy resolves through IAuthorizationPolicyProvider and
      // RateLimiterPolicy through the rate limiter's own map; they share a
      // name because both mean "a signed-in caller", and each is registered
      // separately — the first by AddCommonWebDefaults, the second by
      // Program.cs.
      // Catalog's write side, which catalog-public deliberately does not
      // match: that route names GET alone so a public listing cannot become a
      // public publish by widening one line. A separate route rather than a
      // method added to that one, because the two differ in every field that
      // matters — policy, limiter, and the reason each exists. The endpoint
      // itself still requires catalog:write (CatalogPermissions.Write); this
      // route's "authenticated" is the edge's coarser question, and the two
      // are not redundant for the reason §11.2 gives.
      "catalog-write": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/catalog/{**catch-all}", "Methods": [ "POST", "PUT" ] },
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "authenticated",
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api" }
        ]
      },
      // A seller's own products (ADR-074): a GET that names a caller, so it must
      // not ride catalog-public's anonymous pair. A literal path outranks that
      // route's catch-all in routing precedence, so no Order is needed.
      "catalog-own": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/v1/catalog/products/mine", "Methods": [ "GET" ] },
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "authenticated",
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "RequestHeader": "X-Forwarded-Prefix", "Set": "/api" }
        ]
      },
      "ordering": {
        "ClusterId": "ordering",
        "Match": { "Path": "/api/v1/orders/{**catch-all}" },
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "authenticated",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      // inventory:admin is a permission, not a role (§11.4), and this is where
      // role-shaped names creep back in because a route file feels like
      // infrastructure rather than authorization code. It carries a rate
      // limiter for the reason §10.2 spells out: an authorised client with a
      // broken retry loop is still a flood, and this one reaches a database.
      "inventory-admin": {
        "ClusterId": "inventory",
        "Match": { "Path": "/api/v1/inventory/{**catch-all}" },
        "AuthorizationPolicy": "inventory:admin",
        "RateLimiterPolicy": "authenticated",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      // payments:admin, for the reason inventory:admin's comment gives: a
      // permission, and a rate limiter because an authorised loop still
      // reaches a database. Read-only; a refund stays at the provider.
      "payments-admin": {
        "ClusterId": "payments",
        "Match": { "Path": "/api/v1/payments/{**catch-all}" },
        "AuthorizationPolicy": "payments:admin",
        "RateLimiterPolicy": "authenticated",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      // privacy:erase, on payments-admin's terms: raising an erasure request is a
      // staff act (ADR-092), and an authorised loop still reaches a database.
      "privacy-erase": {
        "ClusterId": "privacy",
        "Match": { "Path": "/api/v1/privacy/{**catch-all}" },
        "AuthorizationPolicy": "privacy:erase",
        "RateLimiterPolicy": "authenticated",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      // /bff rather than /api, because a client picks one or the other:
      // aggregated responses shaped for a screen, or the service APIs shaped
      // for a resource. A second namespace, so a second — and only a second —
      // prefix strip. /v1 rather than the whole namespace: the BFF's anonymous
      // health endpoints share its port, and only its API is published.
      "web-bff": {
        "ClusterId": "web-bff",
        "Match": { "Path": "/bff/v1/{**catch-all}" },
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "authenticated",
        "Transforms": [ { "PathRemovePrefix": "/bff" } ]
      }
    },
    "Clusters": {
      // Destinations are container names under Compose (§14.1) and Service DNS
      // names in Kubernetes; the platform handles discovery either way. Active
      // health checks still matter there — they let YARP stop routing to a pod
      // that is failing but not yet failing its readiness probe.
      //
      // PowerOfTwoChoices picks two destinations at random and routes to the
      // less loaded of the pair, avoiding both the herd behaviour of
      // least-requests and the blindness of round-robin.
      "catalog": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "d1": { "Address": "http://catalog-api:8080/" }
        }
      },
      "ordering": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "d1": { "Address": "http://ordering-api:8080/" }
        }
      },
      "inventory": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "d1": { "Address": "http://inventory-api:8080/" }
        }
      },
      "payments": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "d1": { "Address": "http://payments-api:8080/" }
        }
      },
      "privacy": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "d1": { "Address": "http://privacy-api:8080/" }
        }
      },
      "web-bff": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "d1": { "Address": "http://web-bff:8080/" }
        }
      }
    }
  }
}
