<Project Sdk="Microsoft.NET.Sdk">

  <!-- Settings from Directory.Build.props (§4.1); §4.2's third row permits any package besides. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Dapper" />
    <!-- Carried by the EF provider too; referenced because SqlConnectionFactory names it (§6.5). -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <!-- The bus (§9); no RabbitMQ health-check package, as AddMassTransit registers the bus check itself. -->
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <!-- The stats types' brief cache of §13.6's gauge reads. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    <!-- The carrier's typed client (§3.1's anti-corruption layer) and the address read's pipeline. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- IHostEnvironment, which AddCarrierGateway takes for the scheme rule. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- The client half of ADR-052's read: one row in Appendix B, as they ship and version together. -->
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <!-- Build-time only: protoc and the C# plugin. -->
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- JwtSecurityTokenHandler, with which the grant check reads its token (ADR-052). -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Linked, not copied, so client and server cannot drift; a file, so Common.Contracts stays the only
         assembly crossing a service boundary (§4.3). Internal, so Ordering's types are not this surface. -->
    <Protobuf
      Include="..\..\Ordering\Ordering.Api\Protos\delivery_addresses.proto"
      Link="Protos\delivery_addresses.proto"
      GrpcServices="Client"
      Access="Internal" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shipping.Domain\Shipping.Domain.csproj" />
    <ProjectReference Include="..\Shipping.Application\Shipping.Application.csproj" />
    <!-- §9.4's outbox, §9.5's inbox and §8.5's marker store. -->
    <ProjectReference Include="..\..\..\BuildingBlocks\Common.Infrastructure\Common.Infrastructure.csproj" />
    <!-- MessageTypeSource's Broker half, anchored on IIntegrationEvent. -->
    <ProjectReference Include="..\..\..\BuildingBlocks\Common.Contracts\Common.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Named here rather than widening a type or member no production caller uses. -->
    <InternalsVisibleTo Include="Shipping.Worker.Tests" />
  </ItemGroup>

</Project>
