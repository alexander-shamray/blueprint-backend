<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Domain, Common.Application and Common.Contracts, §4.2's second row. Contracts arrives with the §9.3
    mapper's first entry.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Privacy.Domain\Privacy.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Common.Application\Common.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Common.Contracts\Common.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The read side of §6.5: query handlers use Dapper directly, never EF. -->
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- Referenced directly because used directly, for §4.2's assembly-scan registration. -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

</Project>
