  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Privacy.Domain\Privacy.Domain.csproj" />
    <ProjectReference Include="..\Privacy.Application\Privacy.Application.csproj" />
    <!-- §9.4's outbox, and §8's Redis helpers beside it. -->
    <ProjectReference Include="..\..\..\BuildingBlocks\Common.Infrastructure\Common.Infrastructure.csproj" />
