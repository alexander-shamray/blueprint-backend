<Project Sdk="Microsoft.NET.Sdk">

  <!--
    §4.1's migrator and §7.4's job host: ADR-007 forbids migrating at startup,
    so the schema is applied by a process with no listener, holding the one
    identity that has DDL (§7.1).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- Design-time only: `dotnet ef migrations add` needs it here, and the running job does not. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Notifications.Infrastructure\Notifications.Infrastructure.csproj" />
  </ItemGroup>

</Project>
