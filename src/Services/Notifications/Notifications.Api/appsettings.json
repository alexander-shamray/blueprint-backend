{
  // Catalog.Api's appsettings.json argues the shape and why each port is declared here (§9.7): an Http2-only
  // endpoint for the BFF's gRPC hop beside an Http1 one for the probes, since Kestrel:Endpoints overrides the
  // image's port and cleartext cannot negotiate HTTP/2 on one port.
  "Kestrel": {
    "Endpoints": {
      // The health probes (§13.5), the one surface this host serves today.
      "Rest": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      // ADR-117's registration method and ADR-120's preferences, the BFF's alone; no gateway route reaches it.
      "Grpc": {
        "Url": "http://0.0.0.0:8081",
        "Protocols": "Http2"
      }
    }
  }
}
