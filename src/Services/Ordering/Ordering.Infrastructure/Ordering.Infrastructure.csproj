<Project Sdk="Microsoft.NET.Sdk">

  <!-- Settings from Directory.Build.props (§4.1); §4.2's third row permits any package besides. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Dapper" />
    <!-- Carried by the EF provider too; referenced because SqlConnectionFactory names it (§6.5). -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <!-- The bus (§9); no RabbitMQ health-check package, as AddMassTransit registers the bus check itself. -->
    <PackageReference Include="MassTransit.RabbitMQ" />
    <!-- §9.6's saga repository, referenced directly because this assembly names its types. -->
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <!-- OutboxStats' brief cache of §13.6's gauge reads. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ordering.Domain\Ordering.Domain.csproj" />
    <ProjectReference Include="..\Ordering.Application\Ordering.Application.csproj" />
    <!-- §9.4's outbox, §9.5's inbox, §8.5's marker store and §8's Redis helpers. -->
    <ProjectReference Include="..\..\..\BuildingBlocks\Common.Infrastructure\Common.Infrastructure.csproj" />
    <!-- MessageTypeSource's Broker half, anchored on IIntegrationEvent. -->
    <ProjectReference Include="..\..\..\BuildingBlocks\Common.Contracts\Common.Contracts.csproj" />
  </ItemGroup>

</Project>
