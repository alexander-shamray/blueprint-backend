<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Settings from Directory.Build.props (§4.1); the one web host, and Program.cs its composition root (§4.2). -->

  <ItemGroup>
    <!-- Appendix C's OpenAPI deliverable: document only, no UI. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- ADR-052's server half; it brings Grpc.Tools and Google.Protobuf, one Appendix B row. -->
    <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ordering owns the contract it serves, and Shipping links it as a Client (§4.3). Both halves, as the
         suite needs a client and a second generated copy would be CS0436, an error under ADR-019. -->
    <Protobuf Include="Protos\delivery_addresses.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ordering.Application\Ordering.Application.csproj" />
    <ProjectReference Include="..\Ordering.Infrastructure\Ordering.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Common.Web\Common.Web.csproj" />
  </ItemGroup>

</Project>
