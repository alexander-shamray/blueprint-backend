<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Settings come from Directory.Build.props (§4.4).

    The Web SDK, because this is the one project in the service that is a
    host. Application and Infrastructure per §4.2's fourth row — Program.cs is
    the only composition root, and the endpoints gate in Catalog.Api.Tests
    holds every other file to Application and Domain contracts.
  -->

  <ItemGroup>
    <!-- Appendix C's OpenAPI deliverable: document only, no UI. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- The server half of §9.7's one synchronous hop. Grpc.AspNetCore brings
         Grpc.Tools and Google.Protobuf with it, which is why neither is named
         here — Appendix B registers all four as one row because they ship and
         version as one thing. -->
    <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Catalog owns the contract because Catalog serves it. Web.Bff compiles
         this same file as a Client, by link — see the comment on that
         reference, and pricing.proto's own header.

         BOTH halves, not Server alone, and the client half is here for its own
         suite. Catalog.Api.Tests drives PricingService over the real pipeline,
         which needs a client; generating one in the test project instead would
         put a second copy of every message type in a compilation that already
         references this assembly, and CS0436 is an error under ADR-019. So the
         choice is a generated client nothing in production calls, or a
         transport adapter no test can reach — and an untested adapter is the
         worse of the two. Web.Bff.TestSupport's own file argues the mirror
         image of this for the server half. -->
    <Protobuf Include="Protos\pricing.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Catalog.Application\Catalog.Application.csproj" />
    <ProjectReference Include="..\Catalog.Infrastructure\Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Common.Web\Common.Web.csproj" />
  </ItemGroup>

</Project>
