<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Domain, Common.Application and Common.Contracts — the §4.2 dependency
    table's second row. Contracts arrives with the §9.3 mapper: its
    allow-list turns a domain event into a public record, so the layer that
    owns the allow-list is the layer that pays for the reference. §4.3's one
    assembly that crosses a service boundary, and it crosses at the mapper.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Catalog.Domain\Catalog.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Common.Application\Common.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Common.Contracts\Common.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The read side of §6.5: query handlers use Dapper directly, never EF —
         the architecture gate in Catalog.Application.Tests holds that line. -->
    <PackageReference Include="Dapper" />
    <!-- Referenced directly because used directly, for §4.2's assembly-scan registration. -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

</Project>
