<Project Sdk="Microsoft.NET.Sdk">

  <!-- Settings from Directory.Build.props (§4.4); §4.2's third row permits any package besides. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Dapper" />
    <!-- Carried by the EF provider too; referenced because SqlConnectionFactory names it (§6.5). -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
    <!-- The bus (§9); no RabbitMQ health-check package, as AddMassTransit registers the bus check itself. -->
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <!-- The provider's typed client and its budget (§3.2's anti-corruption layer). -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- IHostEnvironment, which AddPaymentProvider takes for the scheme rule. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- OutboxStats' brief cache of §13.6's gauge reads. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Payments.Domain\Payments.Domain.csproj" />
    <ProjectReference Include="..\Payments.Application\Payments.Application.csproj" />
    <!-- §9.4's outbox, §9.5's inbox and §8.5's marker store. -->
    <ProjectReference Include="..\..\..\BuildingBlocks\Common.Infrastructure\Common.Infrastructure.csproj" />
    <!-- MessageTypeSource's Broker half, anchored on IIntegrationEvent. -->
    <ProjectReference Include="..\..\..\BuildingBlocks\Common.Contracts\Common.Contracts.csproj" />
  </ItemGroup>

</Project>
