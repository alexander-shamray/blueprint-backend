<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Settings come from Directory.Build.props (§4.4).

    The fifth of §4.1's five projects, and from PR-08 the §7.4 job host rather
    than a shell: every service owns a database and ADR-007 forbids migrating at
    application startup, so the schema is applied by a process with no network
    listener and no user input, holding the one identity that has DDL (§7.1).

    Microsoft.EntityFrameworkCore.Design is design-time only and marked so:
    `dotnet ef migrations add` needs it in the startup project, and nothing in
    the running job does. PrivateAssets stops it flowing to anything that
    references this project — which today is nothing, and is the point.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Payments.Infrastructure\Payments.Infrastructure.csproj" />
  </ItemGroup>

</Project>
