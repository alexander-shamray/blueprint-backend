<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Settings come from Directory.Build.props (§4.4).
  -->

  <ItemGroup>
    <ProjectReference Include="..\Payments.Domain\Payments.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Common.Application\Common.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Common.Contracts\Common.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dapper is not here yet: §6.5's read side uses it directly, and this
         project has no query handler to use it. It joins with the first
         one — an unused package reference is a claim this project would
         not be making. -->
    <!-- AbstractValidator for the command validators, and the assembly-scan
         registration §4.2's sample uses. Both used directly, both referenced
         directly — a transitive compile against Common.Application's copy
         would be a claim this project never states. -->
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <!-- AuthorisePaymentHandler's LoggerMessage.Define call (CA1848 under
         ADR-019 makes log.LogInformation an error), referenced directly
         rather than arriving transitively. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
