{
  // ADR-154's gRPC hop cannot share a port with §10.2's REST surface, for the
  // reason Catalog.Api's appsettings.json measures: a cleartext Kestrel endpoint
  // at Http1AndHttp2 refuses HTTP/2, and an Http2-only one refuses HTTP/1.1.
  //
  // This section replaces the image's own port configuration, so 8080 is
  // declared here or it stops existing, and the Compose mapping and the
  // gateway's destination would both break.
  "Kestrel": {
    "Endpoints": {
      "Rest": {
        "Url": "http://0.0.0.0:8080",
        "Protocols": "Http1"
      },
      // The BFF's hop and nothing else: not routed by the gateway (§10.2 routes
      // HTTP), not published by Compose, and authenticated all the same (§11.2).
      "Grpc": {
        "Url": "http://0.0.0.0:8081",
        "Protocols": "Http2"
      }
    }
  }
}
