<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Settings from Directory.Build.props (§4.1); the one web host, and Program.cs its composition root (§4.2). -->

  <ItemGroup>
    <!-- The OpenAPI document only, no UI (Appendix C). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- The server half of ADR-154's availability hop; it brings Grpc.Tools and Google.Protobuf with it. -->
    <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Inventory owns the contract because Inventory serves it; Web.Bff compiles this file as a Client, by link.
         Both halves, because this project's suite needs a client (see Catalog.Api.csproj for the CS0436 reason). -->
    <Protobuf Include="Protos\stock.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inventory.Application\Inventory.Application.csproj" />
    <ProjectReference Include="..\Inventory.Infrastructure\Inventory.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Common.Web\Common.Web.csproj" />
  </ItemGroup>

</Project>
