<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Settings from Directory.Build.props (§4.1). §7.4's job host, since ADR-007 forbids migrating at startup.
    EF Core Design is for `dotnet ef migrations add`, and PrivateAssets keeps it from flowing further.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inventory.Infrastructure\Inventory.Infrastructure.csproj" />
  </ItemGroup>

</Project>
