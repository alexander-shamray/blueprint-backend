root = true

# House style for the targets Directory.Build.props pins, one dialect for
# the samples under docs/backend-architecture/ and the solution under src/
# and tests/. docs/style-guide.md carries the prose version and the settled
# choices.
#
# EnforceCodeStyleInBuild (ADR-019) makes this file a build input for rules at
# `warning` or above; each rule at that level is stated without exception in
# docs/style-guide.md and says why beside its entry. Everything else stays a
# suggestion, because a rule whose carve-out lives in prose must not fail a
# build it cannot evaluate.

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
indent_size = 2
# No max_line_length: prose wraps at 80 (docs/style-guide.md), but tables,
# links and fenced code legitimately run past it.

[*.{json,yml,yaml}]
indent_size = 2

# The one override of end_of_line above. The Python gates run on a Linux
# runner, and a CRLF shebang makes the kernel look for an interpreter named
# `python3\r`.
[*.py]
end_of_line = lf
indent_size = 4

[*.{cs,csx}]
indent_size = 4
tab_width = 4

# The threshold the wrapping rule turns on, so an editor ruler shows the
# boundary the rule is written against. Roslyn has no wrapping engine, so this
# value is a declaration and docs/style-guide.md carries the rule.
# csharp_new_line_before_open_brace is deliberately unset: the default, `all`,
# is the house rule for braces, and csharp_preserve_single_line_blocks below
# keeps `{ get; init; }` and `o => { /* §11.3 */ }` on one line under it.
max_line_length = 120

# --- Wrapping: what a formatter must not undo ---
# The settings that keep a `dotnet format` run idempotent against code that
# already follows docs/style-guide.md.

# The braceless body goes on the line after its condition, never beside it —
# the rule that makes csharp_prefer_braces = false readable. At the default a
# formatter would pull `app.UseCors();` back up onto its `if (corsEnabled)`.
csharp_preserve_single_line_statements = false

# ...but a one-line block stays one line: `{ get; init; }`, and
# `o => { /* §11.3 */ }` where the elision is the point.
csharp_preserve_single_line_blocks = true

# Reaches a local declaration statement — `int a      = 1;` — and nothing
# else; a padded `{`, `=` or `=>` on a member is IDE0055's. Left at ignore
# because no local declaration in the corpus pads an `=` either way.
csharp_space_around_declaration_statements = ignore

# Members of a multi-line initialiser get one line each — the list rule, in the
# one place Roslyn can state it. Stated beside
# csharp_preserve_single_line_blocks because that is what keeps
# `new { q.ProductId }` from being exploded by it.
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true

# No setting expresses the remaining wrapping rules — `=>` placement, broken
# fluent chains, argument lists holding a lambda, the outermost-bracket break,
# a leading `[`, and the whitespace between a type and its identifier — and
# `dotnet format` neither introduces nor undoes them, so nothing has to be
# pinned. docs/style-guide.md carries them; the closest enforcement is
# dotnet_style_operator_placement_when_wrapping in [*.cs], which governs
# binary operators only.

# There is deliberately no [*.sql] section: §7.4 ships hand-written DDL inside
# a migration's `migrationBuilder.Sql("""…""")` and nothing else, so every
# statement sits in a C# raw string literal no formatter reads. The SQL
# conventions in docs/style-guide.md are a review rule for that reason.

# --- .NET / C# style ---
# At warning: docs/style-guide.md states this one without exception, and
# EnforceCodeStyleInBuild with ADR-019's TreatWarningsAsErrors makes it a
# failed build. It binds source only.
csharp_using_directive_placement = outside_namespace:warning
csharp_space_around_binary_operators = before_and_after
csharp_indent_labels = one_less_than_current
csharp_prefer_simple_using_statement = true:suggestion
csharp_prefer_simple_default_expression = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion
csharp_style_prefer_index_operator = true:suggestion
csharp_style_prefer_range_operator = true:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
csharp_style_unused_value_assignment_preference = discard_variable:suggestion
csharp_preferred_modifier_order = public, private, protected, internal, file, new, static, abstract, virtual, sealed, readonly, override, extern, unsafe, volatile, async, required:suggestion

# Explicit types, except where the right-hand side already names the type —
# a reader of a fenced code block has no hover to fall back on.
# docs/style-guide.md lists the cases that keep `var`; one of them, a fluent
# resource DSL, cannot be expressed as a setting, which is why these stay at
# suggestion rather than warning.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_deconstructed_variable_declaration = true:suggestion

# --- Settled choices ---
# House style a reviewer might read as an oversight; docs/style-guide.md
# tabulates them, and changing one is a decision about the whole corpus.

# A single statement may omit braces. Roslyn cannot express "one statement,
# wrapped or not", so this is declarative and docs/style-guide.md carries the
# rule.
csharp_prefer_braces = false:silent

# At warning: file-scoped, never block-scoped, is a settled choice with no
# exception. The blank line the guide requires after `namespace X;` needs no
# setting, because IDE0055 already reports a type written straight under it.
csharp_style_namespace_declarations = file_scoped:warning

# Expression bodies for one-line members but not constructors. Stated as one
# block rather than left to inherited defaults, so the policy reads whole.
csharp_style_expression_bodied_methods = true:silent
csharp_style_expression_bodied_constructors = false:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent
csharp_style_expression_bodied_lambdas = true:silent

[*.cs]
# The formatting rule. IDE0055 is an aggregate: it reports every formatting
# option in this file a source file disagrees with, which is what turns the
# settings above into build failures. It reaches only as far as Roslyn's
# formatter does — the wrapping rules stay review's — and column alignment
# (`TotalAmount  { get; init; }`) is a violation it does report; a trailing
# `//` comment may sit in any column.
dotnet_diagnostic.IDE0055.severity = warning

# Trailing, not leading. A wrapped condition reads as a sequence of lines each
# announcing "and there is more"; the alternative buries that signal at the
# start of the next line, where it also collides with the four-space body
# indent.
dotnet_style_operator_placement_when_wrapping = end_of_line
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion
dotnet_style_prefer_auto_properties = true:silent
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
# IDE0305 is the analyser behind docs/style-guide.md's "materialise with a
# spread, not a terminal .ToArray()". Left at suggestion: the guide exempts a
# stream accessor, because `MemoryStream` implements no `IEnumerable` and
# `[.. buffer]` does not compile (CS9212), and growing ADR-019's enforced set
# is a decision about the policy, not about this line.
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion
dotnet_style_prefer_simplified_boolean_expressions = true:suggestion
dotnet_style_prefer_compound_assignment = true:suggestion
dotnet_style_prefer_simplified_interpolation = true:suggestion
dotnet_style_explicit_tuple_names = true:suggestion
dotnet_style_namespace_match_folder = true:suggestion
dotnet_style_predefined_type_for_locals_parameters_members = true:suggestion
dotnet_style_predefined_type_for_member_access = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion

dotnet_naming_rule.interface_should_be_begins_with_i.severity = suggestion
dotnet_naming_rule.interface_should_be_begins_with_i.symbols = interface
dotnet_naming_rule.interface_should_be_begins_with_i.style = begins_with_i

dotnet_naming_rule.types_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.types_should_be_pascal_case.symbols = types
dotnet_naming_rule.types_should_be_pascal_case.style = pascal_case

dotnet_naming_rule.non_field_members_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.non_field_members_should_be_pascal_case.symbols = non_field_members
dotnet_naming_rule.non_field_members_should_be_pascal_case.style = pascal_case

dotnet_naming_symbols.interface.applicable_kinds = interface
dotnet_naming_symbols.interface.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected

dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum
dotnet_naming_symbols.types.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected

dotnet_naming_symbols.non_field_members.applicable_kinds = property, event, method
dotnet_naming_symbols.non_field_members.applicable_accessibilities = public, internal, private, protected, protected_internal, private_protected

dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

dotnet_naming_style.pascal_case.capitalization = pascal_case
