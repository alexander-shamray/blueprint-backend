<Project>

  <!--
    Shared MSBuild settings for every project (§4.1). The target framework is
    a platform-wide decision, so it is set once here and not per project.
  -->
  <PropertyGroup Label="Target">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Build output leaves the source trees: one `artifacts/` directory at the
    root holds every `bin/` and `obj/`, in the shape §4.1 draws, and
    `.github/output-gate/` fails CI on the day a build writes into `src/` or
    `tests/` again. `UseArtifactsOutput` has to be set here rather than in a
    project, because the SDK computes output paths before a project's own
    properties are imported and fails with NETSDK1199 when it is set too late.
    `ArtifactsPath` is spelled out so the location is a decision this file
    owns; `MSBuildThisFileDirectory` carries its own trailing separator.
  -->
  <PropertyGroup Label="Output">
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <!--
    ADR-019's analyser policy. TreatWarningsAsErrors is what makes the other
    lines mean anything; EnforceCodeStyleInBuild reaches only the rules
    .editorconfig configures at warning, and the rest stay below warning
    because a style rule with an exception it cannot express must not fail a
    build.
    latest-Recommended rather than latest-All, because All turns on the
    documentation and globalisation categories this platform has not adopted.
    This file is the one place ADR-019 permits a suppression, `#pragma` being
    forbidden, and each argues its case beside its own NoWarn line.
  -->
  <PropertyGroup Label="Analysis">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>

    <!--
      CA1716 flags a name that is a reserved word in another .NET language, and
      fires on `Error` (§10.5). It protects a VB or F# consumer of a published
      library, and there is none: every project is consumed by C# inside this
      repository, and §4.3 permits one assembly to cross a service boundary.
    -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>

    <!--
      CA1711 bans a reserved suffix on a type name and fires on `NextDelegate`
      (§6.2), which is a delegate. It protects the same absent consumer as
      CA1716 above, and the cost — a later `OrderCollection` that is not a
      collection goes uncaught — is a decision about the whole corpus, which
      is why it is made here.
    -->
    <NoWarn>$(NoWarn);CA1711</NoWarn>
  </PropertyGroup>

  <!--
    CA1707 bans underscores in member names, and every test name in §12 is a
    sentence written with them, because a test name is read in a failure report
    by someone not looking at the code. Scoped to test projects by name, so a
    `_`-laden member in production code still fails the build; EndsWith('Tests')
    rather than '.Tests' because Platform.IntegrationTests (§12.6) ends with
    the word and not the dotted suffix.
  -->
  <PropertyGroup Label="Test analysis" Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <!--
    Deterministic builds everywhere; path normalisation only on CI, because
    ContinuousIntegrationBuild rewrites PDB source paths to be
    repository-relative and that breaks local step-through debugging. GitHub
    Actions sets CI on every runner.
  -->
  <PropertyGroup Label="Build">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
